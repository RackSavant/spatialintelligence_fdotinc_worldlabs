# --- Marble / World Labs -------------------------------------------------
# platform.worldlabs.ai/api-keys — requires purchased credits or every call 402s
WORLDLABS_API_KEY=

# --- Gemini (Nano Banana Pro image editing) ------------------------------
GEMINI_API_KEY=

# --- Postgres ------------------------------------------------------------
# Local:  postgres://postgres:postgres@localhost:5432/marble
# Neon:   use the POOLED connection string
DATABASE_URL=

# --- Cloudflare R2 (S3-compatible; zero egress) --------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marble-hack
# Public base URL for the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_BASE_URL=
